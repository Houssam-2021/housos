# fastfetch/neofetch show the HoussamOS logo and info.
# Loaded after Bazzite's bazzite-neofetch.fish, so these aliases replace its ones.
alias fastfetch='/usr/bin/fastfetch -c /usr/share/houssamos/fastfetch.jsonc'
alias neofetch='/usr/bin/fastfetch -c /usr/share/houssamos/fastfetch.jsonc'
alias neowofetch='/usr/bin/fastfetch -c /usr/share/houssamos/fastfetch.jsonc'
