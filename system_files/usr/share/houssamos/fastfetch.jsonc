{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // HoussamOS system info: the ASCII logo on top (it is too wide to sit beside the info)
    "logo": {
        "type": "file",
        "source": "/usr/share/houssamos/logo.txt",
        "position": "top",
        "color": {
            "1": "38;2;52;130;246"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;52;130;246"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "format": "{pretty-name}"
        },
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "display",
        "battery",
        "break",
        "colors"
    ]
}
