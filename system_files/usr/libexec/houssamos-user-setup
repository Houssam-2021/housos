#!/usr/bin/bash
# Applies the HoussamOS look to this account once, at login.
#
# Accounts that already existed (for example created under Bazzite) keep their own saved KDE
# settings, which override the system-wide HoussamOS defaults. This puts the HoussamOS Global
# Theme, wallpaper and terminal profile in place for them. It runs again only when LOOK_VERSION
# is raised, so after that the user's own changes are left alone.

LOOK_VERSION=1
config="${XDG_CONFIG_HOME:-$HOME/.config}"
marker="$config/houssamos-look-version"

[ "$(cat "$marker" 2> /dev/null)" = "$LOOK_VERSION" ] && exit 0

# The wallpaper is set through Plasma itself, so wait until it is running
for _ in $(seq 30); do
    busctl --user status org.kde.plasmashell > /dev/null 2>&1 && break
    sleep 1
done

plasma-apply-lookandfeel --apply org.houssamos.glass.desktop
plasma-apply-wallpaperimage /usr/share/wallpapers/HoussamOS
kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image \
    --group General --key Image "file:///usr/share/wallpapers/HoussamOS/"
kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile HoussamOS.profile

# Bazzite's welcome app, copied into accounts created before HoussamOS
rm -f "$config/autostart/bazzite-portal.desktop"

echo "$LOOK_VERSION" > "$marker"
