#!/usr/bin/bash
# Puts desktop PCs (no battery) in the performance power profile once, at first boot: the CPU
# keeps its boost clocks ready for games instead of climbing up from balanced. Laptops stay on
# balanced to save battery, and handhelds (where Bazzite hands power to its own TDP control) are
# left alone. A profile picked later in the power menu is kept; this never runs again.

marker=/var/lib/houssamos/power-default-done
mark_done() {
    mkdir -p "${marker%/*}"
    touch "$marker"
}

if ls /sys/class/power_supply/BAT* > /dev/null 2>&1; then
    mark_done
    exit 0
fi

# tuned-ppd provides the power profiles; wait for it, and skip if it isn't running (handhelds)
for _ in $(seq 30); do
    busctl status net.hadess.PowerProfiles > /dev/null 2>&1 && break
    sleep 1
done
if ! busctl status net.hadess.PowerProfiles > /dev/null 2>&1; then
    mark_done
    exit 0
fi

busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles \
    ActiveProfile s performance && mark_done
