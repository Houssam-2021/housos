// HoussamOS boot animation (Plymouth script theme).
// Generated by branding/make_branding.py from branding/houssamos.script.in: edit the template, not the output.
//
// Plays frame-1.png ... frame-@FRAME_COUNT@.png in a loop at @FPS@ fps, centred on the background.
// Frames are loaded one at a time instead of all up front to keep memory use low during boot.

frame_count = @FRAME_COUNT@;
fps = @FPS@;
refresh_rate = 50;   // Plymouth calls the refresh function about 50 times a second

Window.SetBackgroundTopColor(@BG@, @BG@, @BG@);
Window.SetBackgroundBottomColor(@BG@, @BG@, @BG@);

// Twice the size on 4K-class screens
fun scale_for(width)
{
    s = Math.Int((width + 400) / 1920);
    if (s < 1) s = 1;
    return s;
}

fun load_frame(index, s)
{
    image = Image("frame-" + (index + 1) + ".png");
    if (s > 1)
        image = image.Scale(image.GetWidth() * s, image.GetHeight() * s);
    return image;
}

// The screen size can change during boot (when the graphics driver takes over, or a VM window
// is resized), so the logo is placed again on every refresh instead of once.
fun place_logo()
{
    global.logo_sprite.SetPosition(Window.GetWidth() / 2 - global.logo_image.GetWidth() / 2,
                                   Window.GetHeight() / 2 - global.logo_image.GetHeight() / 2, 1);
}

scale = scale_for(Window.GetWidth());
logo_image = load_frame(0, scale);
logo_sprite = Sprite(logo_image);
place_logo();

tick = 0;
shown_frame = 0;

fun refresh_callback()
{
    global.tick = global.tick + 1;
    frame = Math.Int(global.tick * fps / refresh_rate) % frame_count;
    s = scale_for(Window.GetWidth());
    if (frame != global.shown_frame || s != global.scale)
    {
        global.scale = s;
        global.logo_image = load_frame(frame, s);
        global.logo_sprite.SetImage(global.logo_image);
        global.shown_frame = frame;
    }
    place_logo();
}
Plymouth.SetRefreshFunction(refresh_callback);

// Text below the logo: disk-unlock password prompt, questions and boot messages
fun text_y()
{
    return Window.GetHeight() / 2 + global.logo_image.GetHeight() / 2 + 40;
}
prompt_sprite = Sprite();
answer_sprite = Sprite();
message_sprite = Sprite();

fun place_centered(sprite, image, y)
{
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetWidth() / 2 - image.GetWidth() / 2, y, 2);
    sprite.SetOpacity(1);
}

fun dark_text(text)
{
    return Image.Text(text, 0.15, 0.15, 0.2, 1, "Sans 16");
}

fun display_password_callback(prompt, bullets)
{
    stars = "";
    for (i = 0; i < bullets; i++)
        stars = stars + "*";
    place_centered(global.prompt_sprite, dark_text(prompt), text_y());
    place_centered(global.answer_sprite, dark_text(stars + "_"), text_y() + 36);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry)
{
    place_centered(global.prompt_sprite, dark_text(prompt), text_y());
    place_centered(global.answer_sprite, dark_text(entry + "_"), text_y() + 36);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback()
{
    global.prompt_sprite.SetOpacity(0);
    global.answer_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text)
{
    place_centered(global.message_sprite, dark_text(text), Window.GetHeight() - 80);
}
Plymouth.SetMessageFunction(message_callback);
